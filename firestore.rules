rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles & Friends Subcollection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /friends/{friendId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }

    // Friend Requests
    match /friend_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow delete: if request.auth != null && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    // Unique Usernames Directory
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid);
    }
    
    // Song Leaderboards & High Scores
    match /leaderboards/{songKey}/scores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
    }

    // Global Songs Catalog Index
    match /songs_catalog/{songKey} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Global Synced Lyrics (Community Timed Lyrics & Offsets)
    match /global_lyrics/{songKey} {
      allow read: if true;
      allow write: if true;
    }

    // Global Synced Music Videos (Community Verified YouTube MV & Offsets)
    match /global_videos/{songKey} {
      allow read: if true;
      allow write: if true;
    }
    
    // Multiplayer Rooms (1v1, Band Co-op, FFA up to 5 players)
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }

    // Multiplayer Room Invites
    match /multiplayer_invites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
  }
}
